{
  "name": "@vaticinus/forecast-core",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Open BYOK forecasting workflow: research, budgeted execution, immutable history and model-versus-harness evaluation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaticinus/vati.git",
    "directory": "forecast-stack/forecast-core"
  },
  "homepage": "https://github.com/vaticinus/vati/tree/main/forecast-stack/forecast-core",
  "bugs": {
    "url": "https://github.com/vaticinus/vati/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    "./engine": "./dist/forecastEngine.js",
    "./harness": "./dist/coherence.js",
    "./snapshot": "./dist/forecastSnapshot.js",
    "./prompt": "./dist/model.js",
    "./provider-context": "./dist/byokContext.js",
    "./runtime": "./dist/runtime.js",
    "./evidence": "./dist/evidence.js",
    "./workflow": "./dist/workflow.js",
    "./benchmark": "./dist/benchmark.js",
    "./data-packs": "./dist/dataPacks.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "example": "node --experimental-strip-types example.mts",
    "eval:list": "node --experimental-strip-types scripts/forecast_eval.mts --list",
    "test:install": "node scripts/install-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "WORKFLOW.md",
    "examples/"
  ],
  "bin": {
    "vati": "dist/cli.js"
  }
}
