# forecast-stack — copy to .env and fill in ONE provider.
# The client auto-detects whichever key is present; the first one wins.

# OpenRouter (one key, many models)
# OPENROUTER_API_KEY=sk-or-...
# FORECAST_STACK_MODEL=deepseek/deepseek-chat

# Fireworks
# FIREWORKS_API_KEY=fw_...
# FORECAST_STACK_MODEL=accounts/fireworks/models/deepseek-v3

# DeepSeek (direct)
# DEEPSEEK_API_KEY=sk-...
# FORECAST_STACK_MODEL=deepseek-chat

# OpenAI
# OPENAI_API_KEY=sk-...
# FORECAST_STACK_MODEL=gpt-4o-mini

# Together / Groq / Anthropic also supported — see forecast_stack/llm.py

# Force a provider or a custom OpenAI-compatible endpoint
# FORECAST_STACK_PROVIDER=deepseek
# FORECAST_STACK_BASE_URL=http://localhost:11434/v1
# FORECAST_STACK_API_KEY=

# Offline deterministic provider — no keys, no network (tests, demos)
# FORECAST_STACK_MOCK=1

# Optional: route rate-limited data fetches (FRED, Yahoo) through a proxy
# FORECAST_STACK_PROXY=http://user:pass@host:port
